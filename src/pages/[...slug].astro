---
import AppRouter from "@/components/Router";
import "@/styles/global.css";
---

<html lang="en" class="w-full h-full">
  <head>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO: Базовые мета-теги -->
    <title>I23NK | Pieces with a history, tailored for the future</title>
    <meta name="description" content="1-of-1 upcycled corsets crafted from vintage clothes. Custom-made to your exact bust and waist measurements." />
    <meta name="keywords" content="upcycled corsets, vintage remake corset, custom bespoke corset, reworked vintage fashion, I23NK, 1-of-1 upcycle" />
    <link rel="canonical" href="https://i23nk.com/" />

    <!-- SEO: Open Graph (Превью для Telegram, Instagram, WhatsApp) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="I23NK" />
    <meta property="og:title" content="I23NK | Upcycled Corsets" />
    <meta property="og:description" content="1-of-1 upcycled corsets crafted from vintage clothes. Custom-tailored to your exact measurements." />
    <meta property="og:image" content="https://i23nk.com/logo-og.png" />
    <meta property="og:url" content="https://i23nk.com/" />

    <!-- SEO: Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="I23NK | Pieces with a history, tailored for the future" />
    <meta name="twitter:description" content="Custom upcycled corsets handmade from vintage clothes. 1-of-1." />
    <meta name="twitter:image" content="https://i23nk.com/logo-og.png" />

    <!-- SEO: Schema.org (Данные для Google) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FashionBrand",
        "name": "I23NK",
        "url": "https://i23nk.com",
        "logo": "https://i23nk.com/logo-og.png",
        "description": "1-of-1 upcycled corsets crafted from vintage clothes. Custom-tailored to your exact measurements.",
        "sameAs": [
          "https://www.instagram.com/i23nk",
          "https://pin.it/6eU79d840"
        ]
      }
    </script>
  </head>

  <body class="w-full h-full">
    <div id="root" class="w-full h-full">
      <AppRouter client:only="react" />
    </div>
  </body>
</html>