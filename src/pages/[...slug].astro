---
import AppRouter from "@/components/Router";
import "@/styles/global.css";
---

<html lang="en" class="w-full h-full">
  <head>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO: Базовые мета-теги -->
    <title>Upcycled Corsets | I23NK</title>
    <meta name="description" content="Discover unique upcycled corsets I23NK, handcrafted in Ukraine. Shop ready-to-ship designs or order a custom corset with worldwide shipping." />
    <meta name="keywords" content="upcycled corset, f-1 corset, custom corset, reworked fashion, I23NK" />
    <link rel="canonical" href="https://i23nk.com/" />

    <!-- SEO: Open Graph (Превью для Telegram, Instagram, WhatsApp) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="I23NK" />
    <meta property="og:title" content="Upcycled Corsets | I23NK" />
    <meta property="og:description" content="Discover unique upcycled corsets I23NK, handcrafted in Ukraine. Shop ready-to-ship designs or order a custom corset with worldwide shipping." />
    <meta property="og:image" content="https://i23nk.com/logo-og.png" />
    <meta property="og:url" content="https://i23nk.com/" />

    <!-- SEO: Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Upcycled Corsets | I23NK" />
    <meta name="twitter:description" content="Discover unique upcycled corsets I23NK, handcrafted in Ukraine. Shop ready-to-ship designs or order a custom corset with worldwide shipping." />
    <meta name="twitter:image" content="https://i23nk.com/logo-og.png" />

    <!-- SEO: Schema.org (Данные для Google) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FashionBrand",
        "name": "I23NK",
        "url": "https://i23nk.com",
        "logo": "https://i23nk.com/logo-og.png",
        "description": "Discover unique upcycled corsets I23NK, handcrafted in Ukraine. Shop ready-to-ship designs or order a custom corset with worldwide shipping.",
        "sameAs": [
          "https://www.instagram.com/i23nk",
          "https://pin.it/6eU79d840"
        ]
      }
    </script>
  </head>

  <body class="w-full h-full">
    <div id="root" class="w-full h-full">
      <AppRouter client:only="react" />
    </div>
  </body>
</html>